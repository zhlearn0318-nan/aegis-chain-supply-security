{
  // 将下列路径替换为受信任、权限受限目录中的绝对路径。
  security: {
    installPolicy: {
      enabled: true,
      // v1 只声明 skill；完成插件/MCP 安装包验收后再加入 plugin。
      targets: ["skill", "plugin"],
      exec: {
        source: "exec",
        command: "C:\\AegisChain\\runtime\\python.exe",
        args: ["C:\\AegisChain\\demo_web\\tools\\openclaw_install_policy.py"],
        timeoutMs: 15000,
        noOutputTimeoutMs: 15000,
        maxOutputBytes: 1048576,
        passEnv: [],
        env: {
          AEGIS_OPENCLAW_SCAN_TIMEOUT_SECONDS: "60",
          // 新协议使用 warn；只接受 allow/block 的旧稳定版改为 block。
          AEGIS_OPENCLAW_REVIEW_MODE: "warn",
          AEGIS_OPENCLAW_AUDIT_DB: "C:\\AegisChain\\data\\admission_audit.db",
          PYTHONUTF8: "1",
          PYTHONIOENCODING: "utf-8",
        },
        // 解释器和 Python 策略脚本的父目录都必须列入可信目录。
        trustedDirs: [
          "C:\\AegisChain\\runtime",
          "C:\\AegisChain\\demo_web\\tools",
        ],
      },
    },
  },
}
