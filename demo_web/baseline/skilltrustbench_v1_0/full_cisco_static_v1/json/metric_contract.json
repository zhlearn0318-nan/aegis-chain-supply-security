    },
    {
      "name": "malicious_fnr",
      "direction": "lower",
      "required": true,
      "definition": "1 - malicious_recall; abstentions are misses"
    },
    {
      "name": "non_normal_recall",
      "direction": "higher",
      "required": true,
      "definition": "predicted_suspicious_or_malicious among all suspicious_or_malicious ground truth"
    },
    {
      "name": "normal_fpr",
      "direction": "lower",
      "required": true,
