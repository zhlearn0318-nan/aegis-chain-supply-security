* text=auto
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
*.log text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.docx binary
*.pdf binary
*.png binary
*.jpg binary

# Frozen experiment evidence is byte-addressed by artifact_manifest.json.
# Preserve exact bytes so checkout conversion cannot invalidate SHA-256.
demo_web/artifacts/** -text -eol whitespace=cr-at-eol,-blank-at-eof
